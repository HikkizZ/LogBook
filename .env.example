# Copia este archivo a `.env` (chmod 600, ignorado por git) y rellena los valores.
# Compose lo lee con `env_file`: los valores con `$` van entre comillas simples y los demás sin comillas.
# Nunca pongas aquí valores reales en la copia versionada.

# Conexión a la base. El host es el servicio `db` del compose. La contraseña debe ser la misma que
# POSTGRES_PASSWORD; usa una que no necesite escaparse en una URL (p. ej. `openssl rand -hex 24`).
DATABASE_URL=postgres://logbook:CAMBIAR_POR_POSTGRES_PASSWORD@db:5432/logbook

# Contraseña del usuario `logbook` de Postgres; la lee el servicio `db` al crear la base por primera vez.
POSTGRES_PASSWORD=

# Hash argon2id de la contraseña de la UI. Genéralo con `pnpm --filter api hash-password` y pégalo
# ENTRE COMILLAS SIMPLES: contiene `$` y sin comillas Compose los trataría como variables.
# Ejemplo de forma: ADMIN_PASSWORD_HASH='$argon2id$v=19$m=65536,p=4,t=3$<salt>$<hash>'
ADMIN_PASSWORD_HASH=

# Origen público exacto, sin barra final (chequeo de Origin/CSRF, RS-10).
APP_ORIGIN=https://logbook.zytech.dev

# Zona horaria inicial (después manda `timezone` de /settings).
APP_TIMEZONE=America/Santiago

# Puerto interno del contenedor; nginx apunta a logbook:3000.
PORT=3000

# Subred de la red Docker `web` (solo el proxy puede fijar X-Forwarded-For). Obtenla en Nexus con:
#   docker network inspect web --format '{{range .IPAM.Config}}{{.Subnet}}{{end}}'
# Ejemplo de forma: 172.18.0.0/16
TRUST_PROXY=

# Producción: sin stack traces, etc. (RS-16).
NODE_ENV=production

# Carpeta con la web compilada; la imagen ya la fija en /app/web, no hace falta cambiarla.
WEB_DIST_DIR=/app/web

# v2 (webhook de GitHub). Déjalo vacío hasta entonces.
GITHUB_WEBHOOK_SECRET=
