{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "apps/api/node_modules/tsx/dist/cli.mjs",
        "watch",
        "--tsconfig",
        "apps/api/tsconfig.json",
        "apps/api/src/server.ts"
      ],
      "port": 3200
    },
    {
      "name": "web",
      "runtimeExecutable": "node",
      "runtimeArgs": ["apps/web/node_modules/vite/bin/vite.js", "apps/web"],
      "port": 3201
    }
  ]
}
