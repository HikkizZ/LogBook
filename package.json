{
  "name": "logbook",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "pnpm --filter shared build && pnpm -r --parallel --filter api --filter web --filter shared dev",
    "typecheck": "pnpm --filter shared build && pnpm -r typecheck",
    "lint": "pnpm --filter shared build && eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "pnpm --filter shared build && pnpm -r --workspace-concurrency=1 test",
    "build": "pnpm -r build",
    "db:up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "db:down": "docker compose -f docker-compose.dev.yml down"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
